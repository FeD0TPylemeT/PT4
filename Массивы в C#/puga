using System;
using System.Drawing;

class Program
{
    static void Main()
    {
        Console.ForegroundColor = ConsoleColor.DarkGray;
        Console.WriteLine("══════════════════════");
        Console.WriteLine(" Средневековая осада");
        Console.WriteLine("══════════════════════");
        Console.WriteLine();
        Console.ResetColor();

        Console.ForegroundColor = ConsoleColor.DarkRed;
        Console.WriteLine("Враг идёт на приступ. Гарнизон готовит оборону.");
        Console.WriteLine("Командир проверяет арсенал, считает волны шторма и следит за стенами...");
        Console.WriteLine();
        Console.ResetColor();

        string[] arsenal = { "Чан с кипящей смолой", "Связка стрел", "Арбалет", "Ремонтный брус", "Сигнальный рог" };

        for (int i = 0; i < arsenal.Length; i++)
        {
            Console.WriteLine($"[{i + 1}]" + arsenal[i]);
        }

        Console.WriteLine();

        Console.Write("Введите предмет для поиска: ");
        string query = Console.ReadLine();

        int index = Array.IndexOf(arsenal, query);
        if (index != -1)

        {
            Console.WriteLine($"Предмет '{query}' найден в слоте [{index + 1}] и готов к использованию.");
            arsenal[index] = "Пусто";
        }

        else
        {
            Console.WriteLine("Предмет в арсенале отсутствует.");
        }


        Array.Clear(arsenal, 0, 2);

        Console.WriteLine();

        foreach (string item in arsenal)
        {
            Console.WriteLine("- " + item);
        }

        Console.WriteLine();

        string[] siegeWeapons = { "Штурмовой отряд с лестницами", "Осадный таран", "Осадная башня" };
        int[] durability = { 40, 85, 140 };
        int[] siegeDamage = { 10, 25, 45 };

        for (int i = 0; i < siegeWeapons.Length; i++)
        {
            Console.WriteLine(siegeWeapons[i] + " - прочность: " + durability[i] + ", урон: " + siegeDamage[i]);
        }

        Console.WriteLine();

        int[] wallDurability = { 100, 85, 45, 90 };
        int[] repelledEnemies = { 12, 8, 15, 6, 10 };

        int min = wallDurability[0];
        for (int i = 1; i < wallDurability.Length; i++)
        {
            if (wallDurability[i] < min) min = wallDurability[i];
        }
        Console.WriteLine("Критическая прочность: " + min);

        int sum = 0;
        for (int i = 0; i < repelledEnemies.Length; i++)
        {
            sum += repelledEnemies[i];
        }
        Console.WriteLine("Отражено бойцов: " + sum);

        Array.Sort(wallDurability);

        Console.WriteLine();

        foreach (int item in wallDurability)
        {
            Console.WriteLine("- " + item);
        }
    }
}
